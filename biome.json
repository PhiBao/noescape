{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": [
      "**",
      "!packages/contracts/artifacts",
      "!packages/contracts/cache",
      "!packages/contracts/types",
      "!packages/contracts/coverage",
      "!packages/contracts/fhevmTemp",
      "!packages/contracts/deployments",
      "!**/dist"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true
  }
}
